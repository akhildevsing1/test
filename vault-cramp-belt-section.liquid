<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet"></noscript>

<style>
.vb,.vb *,.vb *::before,.vb *::after{margin:0;padding:0;box-sizing:border-box}
.vb{
  --ink:#0B0810; --ash:#151120; --line:rgba(255,255,255,.10);
  --text:#EFE7F2; --mute:rgba(239,231,242,.56); --dim:rgba(239,231,242,.34);
  --t50:#FFC96B; --t55:#FF8A5C; --t60:#F2546E;
  --rose:#F2546E; --gold:#E6B45A; --cool:#5B6B8C;
  --serif:'DM Serif Display',Georgia,serif;
  --sans:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,monospace;
  --ease:cubic-bezier(.2,.8,.2,1);
  background:var(--ink); color:var(--text); font-family:var(--sans);
  line-height:1.55; -webkit-font-smoothing:antialiased;
  overflow-x:clip;
}
.vb a{color:inherit;text-decoration:none}
.vb-wrap{max-width:660px;margin:0 auto;padding:0 20px}
.vb-mod{padding:52px 0;border-top:1px solid var(--line)}
.vb-mod:first-child{border-top:0}
.vb-mod--late{content-visibility:auto;contain-intrinsic-size:auto 520px}

/* ---- type ---- */
.vb-eyebrow{font-family:var(--mono);font-size:.63rem;font-weight:700;letter-spacing:.18em;
  text-transform:uppercase;color:var(--gold);margin-bottom:14px;display:block}
.vb-h{font-family:var(--serif);font-weight:400;font-size:clamp(1.55rem,5.6vw,2.15rem);
  line-height:1.18;letter-spacing:-.01em;color:#fff;margin-bottom:12px}
.vb-p{font-size:.95rem;color:var(--mute);max-width:44ch}
.vb-note{font-family:var(--mono);font-size:.66rem;line-height:1.6;color:var(--dim);margin-top:14px}

/* ---- reveal ---- */
.vb-r{opacity:0;transform:translateY(14px);transition:opacity .6s var(--ease),transform .6s var(--ease)}
.vb-in .vb-r{opacity:1;transform:none}
.vb-in .vb-r:nth-child(2){transition-delay:.06s}
.vb-in .vb-r:nth-child(3){transition-delay:.12s}

/* ---- video ---- */
.vb-vid{margin:0 auto 26px;border-radius:14px;overflow:hidden;
  background:var(--ash);border:1px solid var(--line);
  max-width:{{ v_maxw }}}
.vb-vid video{display:block;width:100%;height:auto}
.vb-vid video::-webkit-media-controls{display:none!important}
.vb-vid video::-webkit-media-controls-start-playback-button{display:none!important;-webkit-appearance:none}

/* ---- temperature dial (ch 01) ---- */
.vb-dial{margin-top:24px;background:var(--ash);border:1px solid var(--line);border-radius:14px;padding:20px 18px}
.vb-dial input{position:absolute;opacity:0;width:0;height:0}
.vb-pills{display:flex;gap:8px}
.vb-pills label{flex:1;text-align:center;padding:13px 4px;border-radius:10px;cursor:pointer;
  background:rgba(255,255,255,.03);border:1px solid var(--line);
  font-family:var(--mono);font-size:1.05rem;font-weight:700;color:var(--mute);
  transition:all .3s var(--ease)}
.vb-pills label small{display:block;font-size:.58rem;font-weight:500;letter-spacing:.1em;
  text-transform:uppercase;margin-top:5px;color:var(--dim)}
.vb-dial input:focus-visible+label{outline:2px solid var(--gold);outline-offset:2px}
.vb-dial:has(#vb-h50:checked) label[for=vb-h50]{background:rgba(255,201,107,.12);border-color:rgba(255,201,107,.45);color:var(--t50)}
.vb-dial:has(#vb-h55:checked) label[for=vb-h55]{background:rgba(255,138,92,.12);border-color:rgba(255,138,92,.45);color:var(--t55)}
.vb-dial:has(#vb-h60:checked) label[for=vb-h60]{background:rgba(242,84,110,.12);border-color:rgba(242,84,110,.45);color:var(--t60)}
.vb-bar{height:6px;border-radius:3px;margin:18px 0 14px;background:rgba(255,255,255,.06);overflow:hidden}
.vb-bar i{display:block;height:100%;border-radius:3px;width:33%;
  background:linear-gradient(90deg,var(--t50),var(--t55));transition:width .45s var(--ease),background .45s ease}
.vb-dial:has(#vb-h55:checked) .vb-bar i{width:66%;background:linear-gradient(90deg,var(--t50),var(--t55),var(--t60))}
.vb-dial:has(#vb-h60:checked) .vb-bar i{width:100%;background:linear-gradient(90deg,var(--t55),var(--t60))}
.vb-cap{font-size:.86rem;color:var(--mute);min-height:2.6em}
.vb-cap>span{display:none}
.vb-dial:has(#vb-h50:checked) .vb-cap span[data-h="50"]{display:block}
.vb-dial:has(#vb-h55:checked) .vb-cap span[data-h="55"]{display:block}
.vb-dial:has(#vb-h60:checked) .vb-cap span[data-h="60"]{display:block}
.vb-safe{margin-top:16px;padding-top:14px;border-top:1px solid var(--line);
  font-size:.78rem;line-height:1.65;color:var(--dim)}
.vb-safe b{color:var(--gold);font-weight:600}

/* ---- waist scale (ch 02) ---- */
.vb-scale{margin-top:24px;background:var(--ash);border:1px solid var(--line);border-radius:14px;padding:22px 18px 18px}
.vb-scale-track{height:8px;border-radius:4px;background:rgba(255,255,255,.06);overflow:hidden}
.vb-scale-track i{display:block;height:100%;width:0;border-radius:4px;
  background:linear-gradient(90deg,var(--t50),var(--t55),var(--t60));transition:width 1.4s var(--ease) .25s}
.vb-in .vb-scale-track i{width:100%}
.vb-scale-ticks{display:flex;justify-content:space-between;margin-top:11px;
  font-family:var(--mono);font-size:.7rem;color:var(--dim)}
.vb-scale-ticks b{color:#fff;font-weight:700}
.vb-scale p{margin-top:14px;font-size:.84rem;color:var(--mute)}

/* ---- heat decay chart (ch 03) ---- */
.vb-chart{margin-top:26px;background:var(--ash);border:1px solid var(--line);
  border-radius:14px;padding:18px 14px 12px}
.vb-chart svg{display:block;width:100%;height:auto}
.vb-chart .grid{stroke:rgba(255,255,255,.07);stroke-width:1}
.vb-chart .thresh{stroke:rgba(255,255,255,.22);stroke-width:1;stroke-dasharray:3 4}
.vb-chart .axis{font-family:var(--mono);font-size:8px;fill:var(--dim)}
.vb-chart .tag{font-family:var(--mono);font-size:8.5px;font-weight:700}
.vb-chart .ln{fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;
  stroke-dasharray:100;stroke-dashoffset:100}
.vb-chart .ln--belt{stroke:url(#vbHot)}
.vb-chart .ln--bottle{stroke:var(--cool)}
.vb-chart .area{fill:url(#vbArea);opacity:0}
.vb-in .vb-chart .ln--bottle{animation:vbDraw 1.1s var(--ease) .1s forwards}
.vb-in .vb-chart .ln--belt{animation:vbDraw 1.5s var(--ease) .45s forwards}
.vb-in .vb-chart .area{animation:vbFade .8s ease 1.3s forwards}
.vb-in .vb-chart .dot{animation:vbFade .5s ease 1.5s forwards}
.vb-chart .dot{opacity:0}
@keyframes vbDraw{to{stroke-dashoffset:0}}
@keyframes vbFade{to{opacity:1}}
.vb-key{display:flex;gap:18px;flex-wrap:wrap;margin-top:12px;
  font-family:var(--mono);font-size:.66rem;color:var(--mute)}
.vb-key i{display:inline-block;width:14px;height:2px;vertical-align:middle;margin-right:6px;border-radius:2px}

/* ---- front / back toggle (ch 04) ---- */
.vb-toggle{margin-top:24px;background:var(--ash);border:1px solid var(--line);border-radius:14px;padding:20px 18px}
.vb-toggle input{position:absolute;opacity:0;width:0;height:0}
.vb-tabs{display:flex;gap:8px}
.vb-tabs label{flex:1;text-align:center;padding:14px 4px;border-radius:10px;cursor:pointer;
  background:rgba(255,255,255,.03);border:1px solid var(--line);
  font-family:var(--mono);font-size:.72rem;font-weight:700;letter-spacing:.09em;
  text-transform:uppercase;color:var(--mute);transition:all .3s var(--ease)}
.vb-toggle input:focus-visible+label{outline:2px solid var(--gold);outline-offset:2px}
.vb-toggle:has(#vb-front:checked) label[for=vb-front]{background:rgba(242,84,110,.12);border-color:rgba(242,84,110,.45);color:var(--t60)}
.vb-toggle:has(#vb-back:checked) label[for=vb-back]{background:rgba(255,138,92,.12);border-color:rgba(255,138,92,.45);color:var(--t55)}
.vb-tcap{margin-top:16px;font-size:.86rem;color:var(--mute);min-height:3.5em}
.vb-tcap>span{display:none}
.vb-toggle:has(#vb-front:checked) .vb-tcap span[data-p="front"]{display:block}
.vb-toggle:has(#vb-back:checked) .vb-tcap span[data-p="back"]{display:block}

/* ---- anatomy list (ch 05) ---- */
.vb-parts{margin-top:22px;counter-reset:vbp}
.vb-parts div{display:flex;gap:14px;padding:15px 0;border-top:1px solid var(--line)}
.vb-parts div:first-child{border-top:0;padding-top:0}
.vb-parts div::before{counter-increment:vbp;content:'0' counter(vbp);
  font-family:var(--mono);font-size:.66rem;font-weight:700;color:var(--gold);
  padding-top:3px;flex-shrink:0}
.vb-parts b{display:block;font-size:.9rem;color:#fff;font-weight:600;margin-bottom:3px}
.vb-parts span{display:block;font-size:.82rem;color:var(--mute);line-height:1.5}

/* ---- compare ---- */
.vb-tbl{width:100%;border-collapse:collapse;margin-top:20px;font-size:.8rem}
.vb-tbl th,.vb-tbl td{padding:12px 8px;text-align:left;border-bottom:1px solid var(--line);vertical-align:top}
.vb-tbl thead th{font-family:var(--mono);font-size:.6rem;letter-spacing:.09em;text-transform:uppercase;
  color:var(--dim);font-weight:700;padding-bottom:9px}
.vb-tbl thead th:last-child{color:var(--rose)}
.vb-tbl tbody th{font-weight:500;color:var(--mute);width:26%}
.vb-tbl td{color:var(--dim);font-family:var(--mono);font-size:.74rem}
.vb-tbl td:last-child{color:#fff;font-weight:700}

/* ---- specs ---- */
.vb-specs{display:grid;grid-template-columns:1fr 1fr;gap:1px;margin-top:20px;
  background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden}
.vb-specs div{background:var(--ink);padding:14px 13px}
.vb-specs dt{font-family:var(--mono);font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;
  color:var(--dim);margin-bottom:5px}
.vb-specs dd{font-size:.86rem;color:#fff;font-weight:500}

/* ---- faq ---- */
.vb-faq{margin-top:12px}
.vb-faq details{border-bottom:1px solid var(--line)}
.vb-faq summary{list-style:none;cursor:pointer;padding:17px 34px 17px 0;position:relative;
  font-size:.93rem;font-weight:500;color:#fff}
.vb-faq summary::-webkit-details-marker{display:none}
.vb-faq summary::after{content:'+';position:absolute;right:6px;top:15px;
  font-family:var(--mono);font-size:1.1rem;color:var(--rose);transition:transform .3s var(--ease)}
.vb-faq details[open] summary::after{transform:rotate(45deg)}
.vb-faq summary:focus-visible{outline:2px solid var(--gold);outline-offset:3px;border-radius:4px}
.vb-faq p{font-size:.86rem;color:var(--mute);padding:0 8px 18px 0;max-width:52ch}

/* ---- close ---- */
.vb-close{text-align:center}
.vb-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:22px 0 26px;text-align:left}
.vb-steps div{padding:13px 12px;background:var(--ash);border:1px solid var(--line);border-radius:11px}
.vb-steps b{display:block;font-family:var(--mono);font-size:.58rem;letter-spacing:.1em;
  text-transform:uppercase;color:var(--gold);margin-bottom:6px}
.vb-steps span{font-size:.76rem;color:var(--mute);line-height:1.45}
.vb-cta{display:block;width:100%;padding:18px 24px;border:0;border-radius:12px;cursor:pointer;
  background:linear-gradient(135deg,var(--t55),var(--t60));color:#fff;
  font-family:var(--sans);font-size:1rem;font-weight:700;letter-spacing:.01em;
  transition:transform .25s var(--ease),box-shadow .25s var(--ease)}
.vb-cta:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(242,84,110,.28)}
.vb-cta:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.vb-cta[data-busy="1"]{opacity:.6;pointer-events:none}
.vb-under{margin-top:13px;font-family:var(--mono);font-size:.66rem;letter-spacing:.05em;color:var(--dim)}
.vb-flash{animation:vbFlash 1.1s ease 2}
@keyframes vbFlash{0%,100%{box-shadow:0 0 0 0 rgba(242,84,110,0)}50%{box-shadow:0 0 0 5px rgba(242,84,110,.4)}}

@media(min-width:640px){
  .vb-mod{padding:64px 0}
}
@media(prefers-reduced-motion:reduce){
  .vb *,.vb *::before,.vb *::after{animation-duration:.01ms!important;animation-delay:0ms!important;
    transition-duration:.01ms!important}
  .vb-r{opacity:1;transform:none}
  .vb-chart .ln{stroke-dashoffset:0}
  .vb-chart .area,.vb-chart .dot{opacity:1}
  .vb-scale-track i{width:100%}
}

/* ---- social proof bar ---- */
.vb-proof{display:flex;align-items:center;justify-content:center;gap:16px;
  padding:14px 20px;border-bottom:1px solid var(--line)}
.vb-proof-stars{display:flex;align-items:center;gap:6px}
.vb-proof-stars svg{flex-shrink:0}
.vb-proof-rating{font-family:var(--mono);font-size:.82rem;font-weight:700;color:#fff}
.vb-proof-dot{width:3px;height:3px;border-radius:50%;background:var(--dim);flex-shrink:0}
.vb-proof-count{font-family:var(--mono);font-size:.72rem;font-weight:500;color:var(--mute);
  letter-spacing:.02em}
</style>

<div class="vb" id="vb-root">

  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
    <linearGradient id="vbHot" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#FFC96B"/><stop offset="55%" stop-color="#FF8A5C"/><stop offset="100%" stop-color="#F2546E"/>
    </linearGradient>
    <linearGradient id="vbArea" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#FF8A5C" stop-opacity=".22"/><stop offset="100%" stop-color="#FF8A5C" stop-opacity="0"/>
    </linearGradient>
  </defs></svg>

  <!-- social proof bar -->
  <div class="vb-proof">
    <div class="vb-proof-stars">
      <svg width="80" height="14" viewBox="0 0 80 14" fill="none" aria-hidden="true">
        <path d="M7 1.2l1.76 3.57 3.94.57-2.85 2.78.67 3.93L7 10.22 3.48 12.05l.67-3.93L1.3 5.34l3.94-.57L7 1.2z" fill="#E6B45A"/>
        <path d="M23 1.2l1.76 3.57 3.94.57-2.85 2.78.67 3.93L23 10.22l-3.52 1.83.67-3.93-2.85-2.78 3.94-.57L23 1.2z" fill="#E6B45A"/>
        <path d="M39 1.2l1.76 3.57 3.94.57-2.85 2.78.67 3.93L39 10.22l-3.52 1.83.67-3.93-2.85-2.78 3.94-.57L39 1.2z" fill="#E6B45A"/>
        <path d="M55 1.2l1.76 3.57 3.94.57-2.85 2.78.67 3.93L55 10.22l-3.52 1.83.67-3.93-2.85-2.78 3.94-.57L55 1.2z" fill="#E6B45A"/>
        <path d="M71 1.2l1.76 3.57 3.94.57-2.85 2.78.67 3.93L71 10.22l-3.52 1.83.67-3.93-2.85-2.78 3.94-.57L71 1.2z" fill="#E6B45A"/>
        <rect x="71" y="0" width="9" height="14" fill="#0B0810" opacity=".7"/>
      </svg>
      <span class="vb-proof-rating">4.7</span>
    </div>
    <span class="vb-proof-dot"></span>
    <span class="vb-proof-count">10,000+ happy customers</span>
  </div>

  <!-- CH 01 — lights + heat dial -->
  <section class="vb-mod" data-vb-reveal>
    <div class="vb-wrap">
      {%- if v1_src != blank -%}
      <div class="vb-vid vb-r"><video src="{{ v1_src }}" style="aspect-ratio:auto {{ v1_ratio }}" muted loop playsinline preload="none"></video></div>
      {%- endif -%}
      <span class="vb-eyebrow vb-r">{{ v1_eyebrow }}</span>
      <h2 class="vb-h vb-r">{{ v1_head }}</h2>
      <p class="vb-p vb-r">{{ v1_body }}</p>

      <div class="vb-dial vb-r">
        <input type="radio" name="vb-heat" id="vb-h50">
        <input type="radio" name="vb-heat" id="vb-h55" checked>
        <input type="radio" name="vb-heat" id="vb-h60">
        <div class="vb-pills">
          <label for="vb-h50">50°<small>Low</small></label>
          <label for="vb-h55">55°<small>Medium</small></label>
          <label for="vb-h60">60°<small>High</small></label>
        </div>
        <div class="vb-bar"><i></i></div>
        <div class="vb-cap">
          <span data-h="50">Gentle background warmth. The setting to use in the evening, and the one that stretches the battery furthest.</span>
          <span data-h="55">The setting most people stay on. Clearly warm through a t-shirt or kurti, comfortable for a full work morning.</span>
          <span data-h="60">Strong, deep heat for the worst hours of day one. Keep sessions short at this level.</span>
        </div>
        <p class="vb-safe"><b>Wear it over a layer of clothing</b> — never against bare skin. Start low, take it off every 20–30 minutes, and switch it off before you fall asleep. Don't use it on numb skin, broken skin, or over a heat rash.</p>
      </div>
    </div>
  </section>

  <!-- CH 02 — charge + fit -->
  <section class="vb-mod" data-vb-reveal>
    <div class="vb-wrap">
      {%- if v2_src != blank -%}
      <div class="vb-vid vb-r"><video src="{{ v2_src }}" style="aspect-ratio:auto {{ v2_ratio }}" muted loop playsinline preload="none"></video></div>
      {%- endif -%}
      <span class="vb-eyebrow vb-r">{{ v2_eyebrow }}</span>
      <h2 class="vb-h vb-r">{{ v2_head }}</h2>
      <p class="vb-p vb-r">{{ v2_body }}</p>

