<script>
(function(){
  var root=document.getElementById('vb-root');
  if(!root)return;

  var VB_CTA_MODE='form';
  var ROOT_URL=(window.Shopify&&window.Shopify.routes&&window.Shopify.routes.root)||'/';

  var mo=window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* reveal on scroll */
  var mods=root.querySelectorAll('[data-vb-reveal]');
  if(mo||!('IntersectionObserver' in window)){
    mods.forEach(function(m){m.classList.add('vb-in');});
  }else{
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(e.isIntersecting){e.target.classList.add('vb-in');io.unobserve(e.target);}
      });
    },{rootMargin:'0px 0px -12% 0px',threshold:.15});
    mods.forEach(function(m){io.observe(m);});
  }

  /* videos: looping, no controls, no play button */
  var vids=root.querySelectorAll('video');
  function vbPlay(v){v.muted=true;v.play().catch(function(){});}

  if('IntersectionObserver' in window){
    var vio=new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(e.isIntersecting){e.target.vbOn=true;vbPlay(e.target);}
        else{e.target.vbOn=false;e.target.pause();}
      });
    },{rootMargin:'300px 0px'});
    vids.forEach(function(v){vio.observe(v);});
  }else{
    vids.forEach(function(v){v.vbOn=true;vbPlay(v);});
  }

  /* some browsers block autoplay outright (Low Power Mode, data saver,
     theme-editor iframe). the first tap is a user gesture — retry then. */
  function vbRetry(){
    vids.forEach(function(v){if(v.vbOn&&v.paused)vbPlay(v);});
  }
  document.addEventListener('touchstart',vbRetry,{passive:true});
  document.addEventListener('click',vbRetry);

  /* CTA */
  root.addEventListener('click',function(e){
    var btn=e.target.closest('[data-vb-atc]');
    if(!btn)return;
    e.preventDefault();
    if(btn.getAttribute('data-busy')==='1')return;

    if(VB_CTA_MODE==='form'){
      var form=document.querySelector('form[action*="/cart/add"]');
      var target=form&&(form.querySelector('[name="add"]')||form.querySelector('button[type="submit"]'))||form;
      if(target){
        target.scrollIntoView({behavior:mo?'auto':'smooth',block:'center'});
        target.classList.add('vb-flash');
        setTimeout(function(){target.classList.remove('vb-flash');},2400);
        return;
      }
    }

    var id=btn.getAttribute('data-vb-atc');
    if(!id){window.location.href=ROOT_URL;return;}
    var label=btn.textContent;
    btn.setAttribute('data-busy','1');
    btn.textContent='Adding…';
    fetch(ROOT_URL+'cart/add.js',{
      method:'POST',
      headers:{'Content-Type':'application/json','Accept':'application/json'},
      body:JSON.stringify({items:[{id:Number(id),quantity:1}]})
    }).then(function(r){
      if(!r.ok)return r.json().then(function(d){throw new Error(d.description||'Could not add to cart.');});
      return r.json();
    }).then(function(){
      window.location.href=ROOT_URL+'cart';
    }).catch(function(err){
      btn.setAttribute('data-busy','0');
      btn.textContent=label;
      window.alert(err.message);
    });
  });
})();
</script>
